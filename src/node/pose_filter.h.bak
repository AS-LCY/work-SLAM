    double last_chassis_time_ = 0.0;
    double chassis_x_ = 0;
    double chassis_y_ = 0;

    // lidar
    Eigen::Isometry3d last_lidar_smooth_;
    Eigen::Isometry3d curr_lidar_smooth_;
    std::atomic<double> curr_lidar_yaw_;
    std::deque<Eigen::Isometry3d> pose_orig_deque_;

    // filter 
    double last_chassis_x_ = 0;
    double last_chassis_y_ = 0;
    Eigen::Isometry3d curr_lidar_filter_;

    // ros::Time last_chassis_time_;
