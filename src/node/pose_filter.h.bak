    ~PoseFilter();

    bool lidar_init(Eigen::Isometry3d init_pose);
    bool chassis_init();
    void update_lidar(/*double lidar_time,*/ Eigen::Isometry3d curr_lidar_orig);
    void update_chassis(const fairland_msgs::chassic_data &chassis_msg);
    bool run_filter(double k_chassis);
    bool filter_reset();

    bool is_init(){
        bool is_init = update_lidar_init_ && update_chassis_init_;
        return is_init;
    }
    Eigen::Isometry3d get_curr_lidar_smooth(){
        return curr_lidar_smooth_;
    }
    Eigen::Isometry3d get_curr_lidar_filter(){
        return curr_lidar_filter_;
    }




private:
    bool load_param();
    void lidar_position_filter_fst_order(Eigen::Isometry3d last_pose_smooth, Eigen::Isometry3d curr_pose_orig, Eigen::Isometry3d& curr_pose_smooth);
    void lidar_position_filter_window(Eigen::Isometry3d last_pose_smooth, Eigen::Isometry3d cur_pose_orig, Eigen::Isometry3d& curr_pose_smooth);
    
    

