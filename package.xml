<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_slam</name>
  <version>0.0.0</version>
  <description>LIDAR-based Simultaneous Localization and Mapping</description>
  
  <maintainer email="panzhenfu20@126.com">pan</maintainer>
  <license>Apache License 2.0</license> <!-- 请更改为实际许可证 -->

  <!-- 构建工具依赖 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend> <!-- 支持 ament_auto 宏 -->
  
  <!-- ROS2 核心依赖 -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>visualization_msgs</depend>  
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  
  <!-- 自定义消息依赖（假设已迁移到ROS2） -->
  <depend>fairland_msgs</depend>
  
  <!-- 第三方库依赖 -->
  <depend>boost</depend>
  <depend>eigen3</depend>
  <depend>pcl</depend>
  <depend>yaml-cpp</depend>
  <depend>fmt</depend>
  <depend>Sophus</depend>
  <depend>gtsam</depend> 
  <depend>fast_gicp</depend>
  
  <!-- 可选：测试依赖 -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
    <!-- 已移除 ROS1 桥接配置 -->
  </export>
</package>